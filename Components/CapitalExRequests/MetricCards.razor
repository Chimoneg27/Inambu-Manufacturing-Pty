<div class="col">
  <div class="card h-100 border-0 shadow-sm bg-@(Variant)-subtle text-@(Variant)-emphasis">
    <div class="card-body text-center">
      <div class="text-uppercase small fw-semibold text-muted">@Label</div>
      <div class="fs-3 fw-bold mt-2">@Value</div>
    </div>
  </div>
</div>

@* the parameters we will pass into the cards *@
@code {
  [Parameter] public string Label { get; set; } = "";
  [Parameter] public string Value { get; set; } = "";
  [Parameter] public string Variant { get; set; } = "primary"; // "warning" | "success" | "danger" | "primary"
}