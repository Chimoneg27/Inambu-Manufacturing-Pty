@page "/"
@using Microsoft.EntityFrameworkCore
@using Inambu_Manufacturing_Pty.Data
@using Inambu_Manufacturing_Pty.Models
@rendermode InteractiveServer
@using System.Security.Claims;
@inject ApplicationDbContext DbContext
@inject AuthenticationStateProvider AuthProvider

<PageTitle>Inambu Manufacturing (Pty) Ltd</PageTitle>

<h1 class="mb-6">Quality Control Measurement Capture</h1>

<div>
  <h2>Measurement Capture Statistics</h2>

  @if (Statistics.Count > 0)
  {
    <table class="table table-bordered table-striped mb-4">
      <thead>
        <tr>
          <th>Measurement</th>
          <th>Highest</th>
          <th>Lowest</th>
          <th>Variance</th>
          <th>Mean</th>
          <th>Sum</th>
          <th>Standard Deviation</th>
        </tr>
      </thead>
      <tbody>
        @foreach (var stat in Statistics)
        {
          <tr>
            <td>@stat.Key</td>
            <td>@stat.Value.Highest.ToString("F2")</td>
            <td>@stat.Value.Lowest.ToString("F2")</td>
            <td>@stat.Value.Variance.ToString("F2")</td>
            <td>@stat.Value.Mean.ToString("F2")</td>
            <td>@stat.Value.Sum.ToString("F2")</td>
            <td>@stat.Value.StandardDeviation.ToString("F2")</td>
          </tr>
        }
      </tbody>
    </table>
  }
</div>

<EditForm Model="Input" OnValidSubmit="AddMeasurements" FormName="measurementForm" class="row g-3">
  <DataAnnotationsValidator />

  <div class="col-md-6">
    <label for="productionLine" class="form-label">Production Line</label>
    <select @bind="Input.ProductionLineId" class="form-select">
      @foreach (var productLine in ProductionLines)
      {
        <option value="@productLine.Id">@productLine.Name</option>
      }
    </select>
  </div>

  <div class="col-md-6">
    <label for="temperature" class="form-label">Temperature</label>
    <input type="number" class="form-control" step="0.01" @bind="Input.Temperature" @bind:event="oninput">
  </div>

  <div class="col-md-6">
    <label for="humidity" class="form-label">Humidity</label>
    <input type="number" class="form-control" step="0.01" @bind="Input.Humidity" @bind:event="oninput">
  </div>

  <div class="col-md-6">
    <label for="weight" class="form-label">Weight</label>
    <input type="number" class="form-control" step="0.01" @bind="Input.Weight" @bind:event="oninput">
  </div>

  <div class="col-md-6">
    <label for="width" class="form-label">Width</label>
    <input type="number" class="form-control" step="0.01" @bind="Input.Width" @bind:event="oninput">
  </div>

  <div class="col-md-6">
    <label for="length" class="form-label">Length</label>
    <input type="number" class="form-control" step="0.01" @bind="Input.Length" @bind:event="oninput">
  </div>

  <div class="col-md-6">
    <label for="depth" class="form-label">Depth</label>
    <input type="number" class="form-control" step="0.01" @bind="Input.Depth" @bind:event="oninput">
  </div>

  <div class="col-md-6">
    <label for="passed" class="form-label">Passed</label>
    <input type="checkbox" class="form-check-input" style="transform: scale(1.5);" @bind="Input.Passed">
  </div>

  <div class="col-12">
    <button type="submit" class="btn btn-primary">Submit</button>
  </div>
</EditForm>

<table class="table">
  <thead>
    <tr>
      <th>User</th>
      <th>Production Line</th>
      <th>Temperature</th>
      <th>Humidity</th>
      <th>Weight</th>
      <th>Width</th>
      <th>Length</th>
      <th>Depth</th>
      <th>Date Added</th>
      <th>Passed</th>
    </tr>
  </thead>
  <tbody>
    @foreach (var measurement in Measurements)
    {
      <tr>
        <td>@measurement.ApplicationUser.Email</td>
        <td>@measurement.ProductionLine.Name</td>
        <td>@measurement.Temperature</td>
        <td>@measurement.Humidity</td>
        <td>@measurement.Weight</td>
        <td>@measurement.Width</td>
        <td>@measurement.Length</td>
        <td>@measurement.Depth</td>
        <td>@measurement.CapturedAtUtc</td>
        <td>
          @if (measurement.Passed == false)
          {
            <i class="bi bi-x-lg" width="32" height="32" fill="red"></i>
          }
          else
          {
            <i class="bi bi-check2" width="32" height="32" fill="blue"></i>
          }
        </td>
        <td>
          @if (measurement.ApplicationUserId == CurrentUserId)
          {
            <a href="@($"/measurements/edit/{measurement.Id}")" class="btn btn-sm btn-primary">Edit</a>
            <button class="btn btn-sm btn-danger" @onclick="() => DeleteCapture(measurement.Id)">Delete</button>
          }
        </td>
      </tr>
    }
  </tbody>
</table>

@code {
  private List<Measurement> Measurements = new(); // the list of measurements

  private MeasurementInput Input { get; set; } = new(); // so this holds the values that that the user enters into the

  private List<ProductionLine> ProductionLines = new(); // holds the productions lines we will select
                                                        // holds the stats for each measurement
  private Dictionary<string, MeasurementStatistics> Statistics = new();
  private string? CurrentUserId;

  protected override async Task OnInitializedAsync()
  {
    ProductionLines = await DbContext.ProductionLines.ToListAsync();

    var authState = await AuthProvider.GetAuthenticationStateAsync();

    CurrentUserId = authState.User
        .FindFirst(ClaimTypes.NameIdentifier)?.Value;

    if (ProductionLines.Any() && Input.ProductionLineId == 0)
    {
      Input.ProductionLineId = ProductionLines.First().Id;
    }

    await LoadMeasurementsAsync();
  }

  private async Task DeleteCapture(int id)
  {
    var capture = await DbContext.Measurements.FirstOrDefaultAsync(m => m.Id == id);

    if (capture is null)
    {
      return;
    }

    var authState = await AuthProvider.GetAuthenticationStateAsync();
    var userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);

    if (capture.ApplicationUserId != userId)
    {
      return;
    }

    DbContext.Measurements.Remove(capture);
    await DbContext.SaveChangesAsync();
    await LoadMeasurementsAsync();
  }

  private async Task AddMeasurements()
  {
    var authState = await AuthProvider.GetAuthenticationStateAsync();
    var userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier); // grabs the logged in user's id

    if (string.IsNullOrWhiteSpace(userId))
    {
      throw new InvalidOperationException("Authenticated user ID could not be found.");
    }

    var measurement = new Measurement // the shape of the measurement we will make
    {
      Temperature = Input.Temperature,
      Humidity = Input.Humidity,
      Weight = Input.Weight,
      Width = Input.Width,
      Length = Input.Length,
      Depth = Input.Depth,
      Passed = Input.Passed,

      CapturedAtUtc = DateTime.UtcNow,
      ApplicationUserId = userId,

      ProductionLineId = Input.ProductionLineId
    };

    DbContext.Measurements.Add(measurement); // stage the new measurement entry in memory
    await DbContext.SaveChangesAsync(); // then we we write it to our sql server

    Input = new(); // clear the form after successful submission
    await LoadMeasurementsAsync();
  }

  private MeasurementStatistics CalculateStats(IEnumerable<decimal> values)
  {
    var numbers = values.ToList();

    if (numbers.Count == 0)
    {
      return new MeasurementStatistics();
    }

    var sum = numbers.Sum();
    var mean = sum / numbers.Count();
    var variance = numbers.Select(number => (number - mean) * (number - mean)).Sum() / numbers.Count;
    var standardDeviation = (decimal)Math.Sqrt((double)variance);

    return new MeasurementStatistics
    {
      Highest = numbers.Max(),
      Lowest = numbers.Min(),
      Variance = variance,
      Mean = mean,
      Sum = sum,
      StandardDeviation = standardDeviation
    };

  }

  private void RecalculateStatistics()
  {
    Statistics["Temperature"] = CalculateStats(
      Measurements.Select(m => m.Temperature)
    );

    Statistics["Humidity"] = CalculateStats(
      Measurements.Select(m => m.Humidity)
    );

    Statistics["Weight"] = CalculateStats(
      Measurements.Select(m => m.Weight)
    );

    Statistics["Width"] = CalculateStats(
      Measurements.Select(m => m.Weight)
    );

    Statistics["Length"] = CalculateStats(
      Measurements.Select(m => m.Length)
    );

    Statistics["Depth"] = CalculateStats(
      Measurements.Select(m => m.Depth)
    );
  }

  public class MeasurementInput
  {
    public decimal Temperature { get; set; }
    public decimal Humidity { get; set; }
    public decimal Weight { get; set; }
    public decimal Width { get; set; }
    public decimal Length { get; set; }
    public decimal Depth { get; set; }
    public bool Passed { get; set; }

    public int ProductionLineId { get; set; }
  }

  public class MeasurementStatistics
  {
    public decimal Highest { get; set; }
    public decimal Lowest { get; set; }
    public decimal Variance { get; set; }
    public decimal Mean { get; set; }
    public decimal Sum { get; set; }
    public decimal StandardDeviation { get; set; }
  }

  private async Task RefreshMeasurements()
  {
    Measurements = await DbContext.Measurements
        .Include(m => m.ApplicationUser)
        .Include(m => m.ProductionLine)
        .ToListAsync();
  }

  // loads measurements from the database and recalculates our stats
  private async Task LoadMeasurementsAsync()
  {
    Measurements = await DbContext.Measurements
        .Include(measurement => measurement.ApplicationUser)
        .Include(measurement => measurement.ProductionLine)
        .ToListAsync();

    RecalculateStatistics();
  }
}