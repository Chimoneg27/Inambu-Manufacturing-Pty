@page "/"
@using Inambu_Manufacturing_Pty.Components.Measurements
@using Inambu_Manufacturing_Pty.Services;
@using Inambu_Manufacturing_Pty.Models
@rendermode InteractiveServer
@using System.Security.Claims;
@inject IMeasurementService MeasurementService
@inject AuthenticationStateProvider AuthProvider

<PageTitle>Inambu Manufacturing (Pty) Ltd</PageTitle>

<h1 class="mb-6">Quality Control Measurement Capture</h1>

<MeasurementStatisticsTable Statistics="Statistics" />

<div class="card mb-4">
  <div class="card-header">
    <h5 class="mb-0">New Measurement</h5>
  </div>

  <div class="card-body">
    <EditForm Model="Input" OnSubmit="AddMeasurements" FormName="addCaptrue">
      <DataAnnotationsValidator />
      <MeasurementForm Model="Input" ProductionLines="ProductionLines" />

      <div class="col-12 mt-3">
        <button type="submit" class="btn btn-primary">Submit</button>
      </div>
    </EditForm>
  </div>
</div>

<h2>Captured Measurements</h2>

<MeasurementsTable Measurements="Measurements" CurrentUserId="@CurrentUserId" OnDelete="DeleteMeasurement" />

@code {
  private List<MeasurementInputModel> Measurements = new(); // the list of measurements
  private MeasurementInputModel Input { get; set; } = new(); // so this holds the values that that the user enters into
  private List<ProductionLine> ProductionLines = new(); // holds the productions lines we will select
                                                        // holds the stats for each measurement
  private Dictionary<string, MeasurementStatistics> Statistics = new();
  private string? CurrentUserId;

  protected override async Task OnInitializedAsync()
  {
    await LoadDataAsync();
  }

  private async Task LoadDataAsync()
  {
    var authState = await AuthProvider.GetAuthenticationStateAsync();
    CurrentUserId = authState.User
        .FindFirst(ClaimTypes.NameIdentifier)?.Value;

    ProductionLines = await MeasurementService.GetProductionLinesAsync();
    Measurements = await MeasurementService.GetMeasurementsAsync();


    if (ProductionLines.Any() && Input.ProductionLineId == 0) // to prevent our earlier @bind value issue
    {
      Input.ProductionLineId = ProductionLines.First().Id;
    }

    RecalculateStatistics();
  }

  private async Task DeleteMeasurement(int id)
  {
    var authState = await AuthProvider.GetAuthenticationStateAsync();
    var userId = await ResolveCurrentUserIdAsync(authState.User);

    if (string.IsNullOrWhiteSpace(userId))
    {
      return;
    }

    var deleted = await MeasurementService.DeleteMeasurementAsync(id, userId);
    await LoadDataAsync();
  }

  private async Task AddMeasurements()
  {
    var authState = await AuthProvider.GetAuthenticationStateAsync();
    var userId = await ResolveCurrentUserIdAsync(authState.User); // grabs the logged in user's id

    if (string.IsNullOrWhiteSpace(userId))
    {
      throw new InvalidOperationException("Authenticated user ID could not be found.");
    }

    var measurement = new MeasurementInputModel // the shape of the measurement we will make
    {
      Temperature = Input.Temperature,
      Humidity = Input.Humidity,
      Weight = Input.Weight,
      Width = Input.Width,
      Length = Input.Length,
      Depth = Input.Depth,
      Passed = Input.Passed,
      ProductionLineId = Input.ProductionLineId
    };

    await MeasurementService.AddMeasurementAsync(measurement, userId);
    Input = new(); // clear the form after successful submission
    await LoadDataAsync();
  }

  private async Task<string?> ResolveCurrentUserIdAsync(ClaimsPrincipal user)
  {
    return user.FindFirstValue(ClaimTypes.NameIdentifier);
  }

  private void RecalculateStatistics()
  {
    Statistics = MeasurementService.CalculateStatistics(Measurements);
  }
}