@page "/"
@using Inambu_Manufacturing_Pty.Components.Measurements
@using Microsoft.EntityFrameworkCore
@using Inambu_Manufacturing_Pty.Data
@using Inambu_Manufacturing_Pty.Models
@rendermode InteractiveServer
@using System.Security.Claims;
@inject ApplicationDbContext DbContext
@inject AuthenticationStateProvider AuthProvider

<PageTitle>Inambu Manufacturing (Pty) Ltd</PageTitle>

<h1 class="mb-6">Quality Control Measurement Capture</h1>

<MeasurementStatisticsTable Statistics="Statistics" />

<div class="card mb-4">
  <div class="card-header">
    <h5 class="mb-0">New Measurement</h5>
  </div>

  <div class="card-body">
    <EditForm Model="Input" OnSubmit="AddMeasurements" FormName="addCaptrue">
      <DataAnnotationsValidator />
      <MeasurementForm Model="Input" ProductionLines="ProductionLines" />

      <div class="col-12 mt-3">
        <button type="submit" class="btn btn-primary">Submit</button>
      </div>
    </EditForm>
  </div>
</div>

<h2>Captured Measurements</h2>

<MeasurementsTable Measurements="Measurements" CurrentUserId="@CurrentUserId" OnDelete="DeleteMeasurement" />

@code {
  private List<MeasurementInputModel> Measurements = new(); // the list of measurements
  private MeasurementInputModel Input { get; set; } = new(); // so this holds the values that that the user enters into
  private List<ProductionLine> ProductionLines = new(); // holds the productions lines we will select
                                                        // holds the stats for each measurement
  private Dictionary<string, MeasurementStatistics> Statistics = new();
  private string? CurrentUserId;

  protected override async Task OnInitializedAsync()
  {
    await LoadDataAsync();
  }

  private async Task LoadDataAsync()
  {
    var authState = await AuthProvider.GetAuthenticationStateAsync();
    CurrentUserId = authState.User
        .FindFirst(ClaimTypes.NameIdentifier)?.Value;

    ProductionLines = await DbContext.ProductionLines.ToListAsync();
    Measurements = await DbContext.Measurements
            .Include(m => m.ApplicationUser)
            .Include(m => m.ProductionLine)
            .OrderByDescending(m => m.CapturedAtUtc) // we will now see the latest entries in the table
            .ToListAsync();

    if (ProductionLines.Any() && Input.ProductionLineId == 0)
    {
      Input.ProductionLineId = ProductionLines.First().Id;
    }

    RecalculateStatistics();
  }

  private async Task DeleteMeasurement(int id)
  {
    var capture = await DbContext.Measurements
      .Include(measurement => measurement.ApplicationUser)
      .FirstOrDefaultAsync(measurement => measurement.Id == id);

    if (capture is null)
    {
      return;
    }

    var authState = await AuthProvider.GetAuthenticationStateAsync();
    var userId = await ResolveCurrentUserIdAsync(authState.User);

    if (capture.ApplicationUserId != userId)
    {
      return;
    }

    DbContext.Measurements.Remove(capture);
    await DbContext.SaveChangesAsync();
    await LoadDataAsync();
  }

  private async Task AddMeasurements()
  {
    var authState = await AuthProvider.GetAuthenticationStateAsync();
    var userId = await ResolveCurrentUserIdAsync(authState.User); // grabs the logged in user's id

    if (string.IsNullOrWhiteSpace(userId))
    {
      throw new InvalidOperationException("Authenticated user ID could not be found.");
    }

    var measurement = new MeasurementInputModel // the shape of the measurement we will make
    {
      Temperature = Input.Temperature,
      Humidity = Input.Humidity,
      Weight = Input.Weight,
      Width = Input.Width,
      Length = Input.Length,
      Depth = Input.Depth,
      Passed = Input.Passed,

      CapturedAtUtc = DateTime.UtcNow,
      ApplicationUserId = userId,

      ProductionLineId = Input.ProductionLineId
    };

    DbContext.Measurements.Add(measurement); // stage the new measurement entry in memory
    await DbContext.SaveChangesAsync(); // then we we write it to our sql server

    Input = new(); // clear the form after successful submission
    await LoadDataAsync();
  }

  private async Task<string?> ResolveCurrentUserIdAsync(ClaimsPrincipal user)
  {
    return user.FindFirstValue(ClaimTypes.NameIdentifier);
  }

  private MeasurementStatistics CalculateStats(IEnumerable<decimal> values)
  {
    var numbers = values.ToList();

    if (numbers.Count == 0)
    {
      return new MeasurementStatistics();
    }

    var sum = numbers.Sum();
    var mean = sum / numbers.Count();
    var variance = numbers.Sum(n => (n - mean) * (n - mean)) / numbers.Count;
    var standardDeviation = (decimal)Math.Sqrt((double)variance);

    return new MeasurementStatistics
    {
      Highest = numbers.Max(),
      Lowest = numbers.Min(),
      Variance = variance,
      Mean = mean,
      Sum = sum,
      StandardDeviation = standardDeviation
    };

  }

  private void RecalculateStatistics()
  {
    Statistics["Temperature"] = CalculateStats(
      Measurements.Select(m => m.Temperature)
    );

    Statistics["Humidity"] = CalculateStats(
      Measurements.Select(m => m.Humidity)
    );

    Statistics["Weight"] = CalculateStats(
      Measurements.Select(m => m.Weight)
    );

    Statistics["Width"] = CalculateStats(
      Measurements.Select(m => m.Width)
    );

    Statistics["Length"] = CalculateStats(
      Measurements.Select(m => m.Length)
    );

    Statistics["Depth"] = CalculateStats(
      Measurements.Select(m => m.Depth)
    );
  }
}