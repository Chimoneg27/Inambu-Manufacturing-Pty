@page "/capital-requests"

@using System.Security.Claims
@rendermode InteractiveServer
@using Inambu_Manufacturing_Pty.Data
@using Inambu_Manufacturing_Pty.Models
@using Microsoft.EntityFrameworkCore
@inject AuthenticationStateProvider AuthProvider
@inject ApplicationDbContext db
@using Inambu_Manufacturing_Pty.Components.CapitalExRequests

<PageTitle>Submit Capital Request</PageTitle>

<h1 class="mb-4">Submit Capital Request</h1>

<div class="row row-cols-1 row-cols-md-2 row-cols-xl-5 g-3 mb-4">
  <MetricCards Label="Pending" Value='@pendingCount.ToString()' Variant="warning" />
  <MetricCards Label="Approved" Value='@approvedCount.ToString()' Variant="warning" />
  <MetricCards Label="Rejected" Value='@rejectedCount.ToString()' Variant="warning" />
  <MetricCards Label="Pending Value" Value='@totalPendingAmount.ToString()' Variant="warning" />
  <MetricCards Label="Approved Value" Value='@totalApprovedAmount.ToString()' Variant="warning" />
</div>

<div class="card mb-4">
  <div class="card-header">
    <h5 class="mb-0">Request Details</h5>
  </div>

  @* the request form *@
  <div class="card-body">
    <EditForm Model="input" OnValidSubmit="HandleSubmit" class="row g-3" FormName="capitalReqs">
      <DataAnnotationsValidator />
      <ValidationSummary class="alert alert-danger" />

      <CapitalExRequestForm Model="input" />

      <div class="col-12">
        <button type="submit" class="btn btn-primary">Submit Request</button>
      </div>
    </EditForm>
  </div>
</div>

<div class="card mb-4">
  <div class="card-header">
    <h5 class="mb-0">Request Table</h5>
  </div>

  @* the requests table *@
  <CapitalExRequestTable requests="requests" ViewRequest="ViewRequest" />
</div>

@* the popup modal *@
<CapitalRequestDetailModal Request="selectedRequest" History="history" ShowActions="userAction" OnApprove="Approve" OnReject="Reject" OnClose="CloseModal" />

@code
{
  private CapitalExRequestInput input = new();
  private List<CapitalExRequestModel> requests = new();
  private CapitalExRequestModel? selectedRequest;
  private List<ApprovalHistoryModel> history = new();
  private bool userAction;
  private string? currentUserId;
  private int pendingCount;
  private int approvedCount;
  private int rejectedCount;
  private decimal totalPendingAmount;
  private decimal totalApprovedAmount;

  private void CalculateMetrics()
  {
    pendingCount = requests.Count(r => r.Status == CapExStatus.Pending);
    approvedCount = requests.Count(r => r.Status == CapExStatus.Approved);
    rejectedCount = requests.Count(r => r.Status == CapExStatus.Rejected);

    totalApprovedAmount = requests.Where(r => r.Status == CapExStatus.Approved).Sum(r => r.Amount);
    totalPendingAmount = requests.Where(r => r.Status == CapExStatus.Pending).Sum(r => r.Amount);
  }

  private async Task ViewRequest(int requestId)
  {
    selectedRequest = await db.CapitalExRequestModels
                      .Include(req => req.RequestedByUser) // here we will be loading the requests and who requested it
                      .FirstOrDefaultAsync(req => req.Id == requestId);

    history = await db.ApprovalHistoryModels
                    .Include(hist => hist.ActionByUser)
                    .Where(hist => hist.CapitalExId == requestId)
                    .OrderBy(hist => hist.ApprovedOrRejectedAt)
                    .ToListAsync();

    var authState = await AuthProvider.GetAuthenticationStateAsync();
    currentUserId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

    var currentUser = await db.Users.FindAsync(currentUserId);
    userAction = currentUser != null && selectedRequest != null && selectedRequest.Status == CapExStatus.Pending &&
currentUser.StaffLevel.ToString() == selectedRequest.CurrentStage.ToString(); // various checks for which action the
  }

  private async Task Approve(int requestId)
  {
    var req = await db.CapitalExRequestModels.FindAsync(requestId);
    if (req == null) return;

    var action = new ApprovalHistoryModel
    {
      CapitalExId = requestId,
      ActionByUserId = currentUserId!,
      Action = ApprovalChoices.Approved,
      ApprovedOrRejectedAt = DateTime.UtcNow
    };

    db.ApprovalHistoryModels.Add(action);

    var nextStage = ApprovalTierHelper.GetNextStage(req.CurrentStage, req.Amount);

    if (nextStage == ApprovalStage.Finalised)
    {
      req.Status = CapExStatus.Approved;
    }
    else
    {
      req.CurrentStage = nextStage;
    }

    await db.SaveChangesAsync();
    selectedRequest = null;
    history = new();
    await LoadRequests();
  }

  private async Task Reject(int requestId)
  {
    var request = await db.CapitalExRequestModels.FindAsync(requestId);
    if (request == null) return;

    var action = new ApprovalHistoryModel
    {
      CapitalExId = requestId,
      ActionByUserId = currentUserId!,
      Action = ApprovalChoices.Rejected,
      ApprovedOrRejectedAt = DateTime.UtcNow
    };
    db.ApprovalHistoryModels.Add(action);

    // any rejection at any point ends the whole process
    request.Status = CapExStatus.Rejected;

    await db.SaveChangesAsync();

    selectedRequest = null;
    history = new();
    await LoadRequests();
  }

  private async Task HandleSubmit()
  {
    var authState = await AuthProvider.GetAuthenticationStateAsync();
    var userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

    var capitalRequest = new CapitalExRequestModel
    {
      Amount = input.AmountRequested,
      Description = input.Comment,
      RequestedByUserId = userId!,
      Status = CapExStatus.Pending,
      CurrentStage = ApprovalStage.DepartmentManager
    };

    db.CapitalExRequestModels.Add(capitalRequest);
    await db.SaveChangesAsync();

    input = new();
    await LoadRequests();
  }

  private async Task LoadRequests()
  {
    requests = await db.CapitalExRequestModels
                .Include(req => req.RequestedByUser)
                .OrderByDescending(req => req.CreatedAt)
                .ToListAsync();
    CalculateMetrics();
  }

  protected override async Task OnInitializedAsync()
  {
    await LoadRequests();
  }

  private void CloseModal() // for closing our modal
  {
    selectedRequest = null;
    history = new();
  }
}