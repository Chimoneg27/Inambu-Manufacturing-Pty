@using Inambu_Manufacturing_Pty.Models

<div class="table-responsive">
  <table class="table table-striped table-hover">
    <thead>
      <tr>
        <th>User</th>
        <th>Production Line</th>
        <th>Temperature</th>
        <th>Humidity</th>
        <th>Weight</th>
        <th>Width</th>
        <th>Length</th>
        <th>Depth</th>
        <th>Date Added</th>
        <th>Passed</th>
        <th>Debug IDs</th>
        <th>Edit</th>
      </tr>
    </thead>
    <tbody>
      @if (Measurements.Count == 0)
      {
        <tr>
          <td colspan="12" class="text-center text-muted">No measurements captured yet.</td>
        </tr>
      }
      else
      {
        @foreach (var measurement in Measurements)
        {
          <tr>
            <td>@(measurement.ApplicationUser?.Email ?? "Unknown")</td>
            <td>@(measurement.ProductionLine?.Name ?? "N/A")</td>
            <td>@measurement.Temperature</td>
            <td>@measurement.Humidity</td>
            <td>@measurement.Weight</td>
            <td>@measurement.Width</td>
            <td>@measurement.Length</td>
            <td>@measurement.Depth</td>

            <td>@measurement.CapturedAtUtc.ToString("g")</td>
            <td>
              @if (measurement.Passed)
              {
                <i class="bi bi-check-lg text-success fs-5"></i>
              }
              else
              {
                <i class="bi bi-x-lg text-danger fs-5"></i>
              }
            </td>
            <td>@measurement.ApplicationUserId | @CurrentUserId</td>
            <td>
              @if (measurement.ApplicationUserId == CurrentUserId)
              {
                <a href="@($"/measurements/edit/{measurement.Id}")" class="btn btn-sm btn-primary me-1">Edit</a>
                <button class="btn btn-sm btn-danger" @onclick="() => OnDelete.InvokeAsync(measurement.Id)">Delete</button>
              }
            </td>
          </tr>
        }
      }
    </tbody>
  </table>
</div>

@code {
  [Parameter, EditorRequired]
  public List<MeasurementInputModel> Measurements { get; set; } = null!;

  [Parameter]
  public string? CurrentUserId { get; set; }

  [Parameter]
  public EventCallback<int> OnDelete { get; set; }
}